<section class="promo-band page-width"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p></div><a class="button button-dark" href="{{ section.settings.link }}">{{ section.settings.button }} <span>↗</span></a></section>
{% schema %}{"name":"Promo banner","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little something extra"},{"type":"text","id":"title","label":"Heading","default":"Make room for good design."},{"type":"text","id":"text","label":"Text","default":"Explore pieces selected to bring a little more intention to every room."},{"type":"text","id":"button","label":"Button label","default":"Explore all"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Promo banner"}]}{% endschema %}