<section class="page-width collection-page"><div class="collection-hero">{% if collection.image %}{{ collection.image | image_url: width: 2000 | image_tag: loading:'eager' }}{% endif %}<div><p class="eyebrow">The Cortex collection</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div></div><div class="collection-toolbar"><span>{{ collection.products_count }} pieces</span><form method="get"><label for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>{% paginate collection.products by 16 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found in this collection.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Main collection","settings":[]} {% endschema %}