<div class="announcement">{{ section.settings.announcement }}</div>
<section class="hero">
  <div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p><a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span>↗</span></a></div>
  {% if section.settings.hero_image != blank %}<div class="hero-image"><img src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="{{ section.settings.hero_image.alt | escape }}" fetchpriority="high"></div>{% endif %}
</section>
<section class="ticker" aria-label="Store highlights"><div class="ticker-track">{% for i in (1..4) %}<span>GOOD DESIGN. BETTER LIVING. ✳ &nbsp; CORTEX OBJECTS. &nbsp; MADE TO LAST. ✳ &nbsp;</span>{% endfor %}</div></section>
<section class="collection-section"><div class="section-heading"><div><p class="eyebrow">THE EDIT</p><h2>{{ section.settings.products_heading }}</h2></div><a href="{{ routes.all_products_collection_url }}">Shop all ↗</a></div><div class="product-grid">{% assign featured = section.settings.collection %}{% if featured != blank %}{% for product in featured.products limit: 8 %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">{% endif %}<h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></a></article>{% endfor %}{% else %}<p>Select a collection in the theme editor to display products.</p>{% endif %}</div></section>
{% for block in section.blocks %}
  {% case block.type %}
    {% when 'editorial' %}<section class="editorial" {{ block.shopify_attributes }}><p class="eyebrow">{{ block.settings.kicker }}</p><h2>{{ block.settings.title }}</h2><div>{{ block.settings.text }}</div>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">Discover more ↗</a>{% endif %}</section>
    {% when 'image' %}<section class="wide-image" {{ block.shopify_attributes }}>{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">{% endif %}<h2>{{ block.settings.caption }}</h2></section>
    {% when 'marquee' %}<section class="ticker"><div class="ticker-track"><span>{{ block.settings.text }} ✳ &nbsp; {{ block.settings.text }} ✳ &nbsp; {{ block.settings.text }}</span></div></section>
  {% endcase %}
{% endfor %}
<section class="newsletter"><p class="eyebrow">STAY IN THE LOOP</p><h2>{{ section.settings.newsletter_heading }}</h2>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email address</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">Sign up ↗</button>{% endform %}</section>
{% schema %}{"name":"Cortex homepage","settings":[{"type":"text","id":"announcement","label":"Announcement bar","default":"A considered collection for everyday living"},{"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"OBJECTS FOR EVERYDAY LIVING"},{"type":"text","id":"heading","label":"Hero heading","default":"Make room for better living."},{"type":"textarea","id":"subheading","label":"Hero description","default":"Thoughtful pieces. Timeless forms. A more considered way to live."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"products_heading","label":"Products heading","default":"Pieces worth keeping"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"A little more inspiration, occasionally."}],"blocks":[{"type":"editorial","name":"Editorial text","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"OUR APPROACH"},{"type":"text","id":"title","label":"Heading","default":"Less, but considered."},{"type":"richtext","id":"text","label":"Text","default":"<p>Discover thoughtful pieces made to become part of your everyday.</p>"},{"type":"url","id":"link","label":"Link"}]},{"type":"image","name":"Image feature","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption"}]},{"type":"marquee","name":"Animated marquee","settings":[{"type":"text","id":"text","label":"Scrolling text","default":"CORTEX — GOOD DESIGN, BETTER LIVING"}]}],"presets":[{"name":"Cortex homepage","blocks":[{"type":"editorial"},{"type":"marquee"}]}]}{% endschema %}