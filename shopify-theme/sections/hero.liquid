<section class="hero" data-hero><div class="hero-slides">{% for block in section.blocks %}<article class="hero-slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class:'hero-image', widths:'750,1100,1500,2000,2400' }}{% else %}{% if forloop.first %}<img class="hero-image" src="https://hyper-theme-demo.myshopify.com/cdn/shop/files/slideshow-2_4b9bfed8-4c88-4c34-a970-423353d0b03e.jpg?width=2000" alt="Cortex modern living collection">{% else %}<img class="hero-image" src="https://hyper-theme-demo.myshopify.com/cdn/shop/files/slideshow-3_a5017f29-7d75-4e6a-9052-3a6b84946846.jpg?width=2000" alt="Cortex dining and kitchen collection">{% endif %}{% endif %}<div class="hero-copy"><p>{{ block.settings.kicker }}</p><h1>{{ block.settings.title }}</h1>{% if block.settings.button_label != blank %}<a class="button button-dark" href="{{ block.settings.link }}">{{ block.settings.button_label }} <span>↗</span></a>{% endif %}</div></article>{% endfor %}</div>{% if section.blocks.size > 1 %}<div class="hero-controls"><button data-hero-prev aria-label="Previous slide">←</button><span data-hero-count>01 / {{ section.blocks.size }}</span><button data-hero-next aria-label="Next slide">→</button></div>{% endif %}</section>
{% schema %}{"name":"Cortex hero","max_blocks":5,"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"kicker","label":"Eyebrow","default":"Modern elegance"},{"type":"text","id":"title","label":"Heading","default":"Spoke Sofa"},{"type":"text","id":"button_label","label":"Button label","default":"Shop collection"},{"type":"url","id":"link","label":"Button link"}]}],"presets":[{"name":"Cortex hero","blocks":[{"type":"slide"},{"type":"slide","settings":{"kicker":"Contemporary grace","title":"Dining & Kitchen"}}]}]}{% endschema %}