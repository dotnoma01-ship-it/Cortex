<section class="product-page page-width"><div class="product-gallery">{% for image in product.images %}<div class="gallery-image">{{ image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: image.alt }}</div>{% endfor %}</div><div class="product-detail"><p class="eyebrow">{{ product.type }}</p><h1>{{ product.title }}</h1><div class="product-price large">{{ product.selected_or_first_available_variant.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% if product.description != blank %}<div class="product-description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="VariantSelect">Choose an option</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" min="1" value="1"><button class="button button-dark add-button" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% endform %}<div class="product-accordions"><details><summary>Details & materials</summary><div>{{ product.description }}</div></details><details><summary>Shipping & returns</summary><p>Shipping options and return terms are shown at checkout.</p></details></div></div></section>{% schema %}{"name":"Main product","settings":[]} {% endschema %}