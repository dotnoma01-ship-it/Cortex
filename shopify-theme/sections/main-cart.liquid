<section class="page-width cart-page"><p class="eyebrow">Your selection</p><h1>Your bag <span>({{ cart.item_count }})</span></h1>{% if cart.empty? %}<div class="empty-state">Your bag is waiting for something considered. <a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the collection →</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<div class="cart-line">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.variant.title }}</p><input name="updates[]" type="number" min="0" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}" class="text-link">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-summary"><button class="button button-light" type="submit" name="update">Update bag</button><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="button button-dark" type="submit" name="checkout">Continue to checkout →</button></div></form>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]} {% endschema %}