<header class="site-header" data-header><div class="header-inner">
<button class="icon-btn mobile-toggle" data-menu-toggle aria-label="Open menu">☰</button>
<a class="brand" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 280 | image_tag: alt: shop.name }}{% else %}<span>CORTEX<span class="brand-dot">.</span></span>{% endif %}</a>
<nav class="desktop-nav" aria-label="Main navigation">{% for link in section.settings.menu.links %}<div class="nav-item"><a href="{{ link.url }}">{{ link.title }}</a>{% if link.links.size > 0 %}<div class="mega-menu"><div class="mega-links">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title }}</a>{% endfor %}</div><div class="mega-note"><span>THE CORTEX EDIT</span><strong>Design that lives with you.</strong><a href="{{ routes.all_products_collection_url }}">Explore the collection →</a></div></div>{% endif %}</div>{% endfor %}</nav>
<div class="header-actions"><form action="{{ routes.search_url }}" method="get" class="header-search"><input name="q" type="search" placeholder="Search products…" aria-label="Search"><button aria-label="Submit search">⌕</button></form><a class="icon-btn account-link" href="{{ routes.account_url }}" aria-label="Account">♙</a><a class="icon-btn cart-link" href="{{ routes.cart_url }}" aria-label="Cart">Bag <span class="cart-count">{{ cart.item_count }}</span></a></div>
</div><div class="mobile-menu" data-mobile-menu hidden><form action="{{ routes.search_url }}"><input name="q" placeholder="Search products"></form>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% for child in link.links %}<a class="mobile-child" href="{{ child.url }}">{{ child.title }}</a>{% endfor %}{% endfor %}<a href="{{ routes.cart_url }}">Your bag ({{ cart.item_count }})</a></div></header>
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}