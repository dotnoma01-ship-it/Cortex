<section class="editorial page-width"><div class="editorial-image">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1500 | image_tag: loading:'lazy' }}{% endif %}</div><div class="editorial-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2><div>{{ section.settings.text }}</div><a class="text-link" href="{{ section.settings.link }}">{{ section.settings.button }} ↗</a></div></section>
{% schema %}{"name":"Image editorial","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Cortex approach"},{"type":"text","id":"title","label":"Heading","default":"A quieter kind of statement."},{"type":"richtext","id":"text","label":"Text","default":"<p>Thoughtful forms, tactile materials and lasting function. Discover pieces designed to make everyday spaces feel considered.</p>"},{"type":"text","id":"button","label":"Button label","default":"Our story"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Image editorial"}]}{% endschema %}