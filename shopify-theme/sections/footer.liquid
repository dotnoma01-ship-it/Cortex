<footer class="site-footer"><div class="service-strip"><div><b>Considered design</b><span>Pieces made to live with</span></div><div><b>Here to help</b><span>Personal customer support</span></div><div><b>Secure checkout</b><span>Shop with confidence</span></div><div><b>Worldwide delivery</b><span>Selected destinations</span></div></div><div class="footer-main"><div class="footer-news"><a class="brand footer-brand" href="{{ routes.root_url }}">CORTEX<span class="brand-dot">.</span></a><h2>Good design stays with you.</h2><p>Join our newsletter for new arrivals, considered spaces and studio notes.</p>{% form 'customer', class:'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">Subscribe →</button>{% if form.posted_successfully? %}<p class="success">Thanks for subscribing.</p>{% endif %}{% endform %}</div>{% for block in section.blocks %}<div class="footer-links" {{ block.shopify_attributes }}><h3>{{ block.settings.heading }}</h3>{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div>{% endfor %}</div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span><span>{{ powered_by_link }}</span></div></footer>
{% schema %}{"name":"Footer","max_blocks":4,"blocks":[{"type":"menu","name":"Menu column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]}],"presets":[{"name":"Footer","blocks":[{"type":"menu"},{"type":"menu"}]}]}{% endschema %}