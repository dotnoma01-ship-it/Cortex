<section class="page-width collection-page"><p class="eyebrow">Find your piece</p><h1>Search</h1><form action="{{ routes.search_url }}" method="get" class="search-large"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products…"><button class="button button-dark">Search →</button></form>{% if search.performed %}<p class="muted">{{ search.results_count }} results for “{{ search.terms }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[]} {% endschema %}