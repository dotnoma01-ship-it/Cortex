<section class="category-circles page-width"><div class="circle-track">{% for block in section.blocks %}<a class="circle-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 320 | image_tag: loading:'lazy' }}{% else %}{% case block.settings.title %}{% when 'Marble Products' %}<img src="https://s.alicdn.com/@sc04/kf/H7cd77ad85dc241aa80ea231408e90f9c2.jpg_720x720q50.jpg" alt="Marble products">{% when 'Sale Items' %}<img src="https://hyper-theme-demo.myshopify.com/cdn/shop/files/collection-sales.webp?width=320" alt="Sale items">{% when 'Press Tables' %}<img src="https://hyper-theme-demo.myshopify.com/cdn/shop/files/collection-slider-1.jpg?width=320" alt="Press tables">{% when 'Lighting' %}<img src="https://hyper-theme-demo.myshopify.com/cdn/shop/files/collection-slider-2.jpg?width=320" alt="Lighting">{% when 'Spoke Sofa' %}<img src="https://hyper-theme-demo.myshopify.com/cdn/shop/files/collection-slider-3.jpg?width=320" alt="Sofas">{% else %}<span class="circle-empty"></span>{% endcase %}{% endif %}<b>{{ block.settings.title }}</b></a>{% endfor %}</div></section>
{% schema %}{"name":"Category circles","max_blocks":10,"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Chairs"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Category circles","blocks":[{"type":"category","settings":{"title":"Marble Products"}},{"type":"category","settings":{"title":"Sale Items"}},{"type":"category","settings":{"title":"Press Tables"}},{"type":"category","settings":{"title":"Lighting"}},{"type":"category","settings":{"title":"Spoke Sofa"}}]}]}{% endschema %}