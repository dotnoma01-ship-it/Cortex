<section class="category-circles page-width"><div class="circle-track">{% for block in section.blocks %}<a class="circle-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 320 | image_tag: loading:'lazy' }}{% else %}<span class="circle-empty"></span>{% endif %}<b>{{ block.settings.title }}</b></a>{% endfor %}</div></section>
{% schema %}{"name":"Category circles","max_blocks":10,"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Chairs"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Category circles","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}