<article class="product-card"><div class="product-media"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading:'lazy', class:'product-image', widths:'320,480,640,900' }}{% else %}<div class="product-placeholder"></div>{% endif %}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 900 | image_tag: loading:'lazy', class:'product-image product-image-alt' }}{% endif %}</a>{% if product.compare_at_price > product.price %}<span class="product-badge">Sale</span>{% endif %}<button class="quick-add" type="button" data-quick-add data-variant="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>{% if product.available %}+ Quick add{% else %}Sold out{% endif %}</button></div><div class="product-info"><a href="{{ product.url }}" class="product-title">{{ product.title }}</a><div class="product-price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div></article>